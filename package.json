{
  "name": "@dskripchenko/markdown-editor",
  "version": "0.3.1",
  "description": "A Markdown editor for Vue 3 that edits like a word processor: the value is Markdown, the editing is the @dskripchenko/wysiwyg engine — its toolbar, slash menu, shortcuts and live blocks — with source and side-by-side modes, and a lossless round trip",
  "keywords": [
    "markdown",
    "markdown-editor",
    "wysiwyg",
    "commonmark",
    "gfm",
    "vue",
    "vue3",
    "editor",
    "rich-text"
  ],
  "homepage": "https://github.com/dskripchenko/markdown-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/markdown-editor.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/markdown-editor/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check:browser": "node scripts/browser-check.mjs",
    "dev": "vite --config playground/vite.config.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@dskripchenko/ui": "^1.19.1",
    "@dskripchenko/wysiwyg": "^0.7.0 || ^0.8.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@dskripchenko/ui": "^1.24.0",
    "@dskripchenko/wysiwyg": "^0.8.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
